# =============================================================================
# AI Gateway Environment Configuration
# =============================================================================

# =============================================================================
# Option 1: OpenAI (Get key from https://platform.openai.com/api-keys)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Option 2: Anthropic (Get key from https://console.anthropic.com/)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# Option 3: AWS Bedrock (Uses AWS credentials, no API key needed!)
# =============================================================================
# Set USE_BEDROCK=true to enable
USE_BEDROCK=false
AWS_REGION=us-east-1
# AWS_PROFILE=default  # Optional: specify AWS CLI profile

# AWS credentials can be set here OR via:
# - Environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# - AWS CLI: run `aws configure`
# - IAM role (on EC2/Lambda)

# =============================================================================
# Gateway Configuration
# =============================================================================
# Choose your default provider: openai, anthropic, or bedrock
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
LOG_LEVEL=INFO

# Rate Limiting (requests per minute)
RATE_LIMIT_RPM=60

# Cost Tracking
ENABLE_COST_TRACKING=true
